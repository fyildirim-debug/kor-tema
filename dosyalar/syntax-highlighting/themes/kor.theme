{
    "metadata": { "name": "Kor", "revision": 1, "license": "MIT", "author": "Furkan YILDIRIM" },
    "text-styles": {
        "Normal": { "text-color": "#E8E6E3", "selected-text-color": "#FFFFFF" },
        "Keyword": { "text-color": "#EE5A36", "bold": true },
        "ControlFlow": { "text-color": "#EE5A36", "bold": true },
        "Function": { "text-color": "#7FB4F0" },
        "Variable": { "text-color": "#E8E6E3" },
        "Operator": { "text-color": "#FF8A6B" },
        "BuiltIn": { "text-color": "#C88CE0" },
        "Extension": { "text-color": "#7FB4F0", "bold": true },
        "Preprocessor": { "text-color": "#C88CE0" },
        "Attribute": { "text-color": "#F2AA3C" },
        "Char": { "text-color": "#5CBE78" },
        "SpecialChar": { "text-color": "#FFB38A" },
        "String": { "text-color": "#5CBE78" },
        "VerbatimString": { "text-color": "#5CBE78" },
        "SpecialString": { "text-color": "#8FD3A7" },
        "Import": { "text-color": "#C88CE0" },
        "DataType": { "text-color": "#F2AA3C" },
        "DecVal": { "text-color": "#FF8A6B" },
        "BaseN": { "text-color": "#FF8A6B" },
        "Float": { "text-color": "#FF8A6B" },
        "Constant": { "text-color": "#FF8A6B", "bold": true },
        "Comment": { "text-color": "#6B6D78", "italic": true },
        "Documentation": { "text-color": "#7A7D8A", "italic": true },
        "Annotation": { "text-color": "#8A8D9A" },
        "CommentVar": { "text-color": "#9AA0B4" },
        "RegionMarker": { "text-color": "#7FB4F0", "background-color": "#1E2230" },
        "Information": { "text-color": "#F2AA3C" },
        "Warning": { "text-color": "#ED5454" },
        "Alert": { "text-color": "#ED5454", "background-color": "#3A1E1E", "bold": true },
        "Error": { "text-color": "#ED5454", "underline": true },
        "Others": { "text-color": "#5CBE78" }
    },
    "editor-colors": {
        "BackgroundColor": "#17181C",
        "CodeFolding": "#2A2C33",
        "BracketMatching": "#4A2A22",
        "CurrentLine": "#1E1F24",
        "IconBorder": "#17181C",
        "IndentationLine": "#2A2C33",
        "LineNumbers": "#4A4C55",
        "CurrentLineNumber": "#EE5A36",
        "MarkBookmark": "#6096E6",
        "MarkBreakpointActive": "#ED5454",
        "MarkBreakpointReached": "#F2AA3C",
        "MarkBreakpointDisabled": "#8A5A9A",
        "MarkExecution": "#6B6D78",
        "MarkWarning": "#F2AA3C",
        "MarkError": "#ED5454",
        "ModifiedLines": "#F2AA3C",
        "ReplaceHighlight": "#5A3A20",
        "SavedLines": "#5CBE78",
        "SearchHighlight": "#6A3A20",
        "TextSelection": "#4A2A22",
        "Separator": "#2A2C33",
        "SpellChecking": "#ED5454",
        "TabMarker": "#2A2C33",
        "TemplateBackground": "#1E1F24",
        "TemplatePlaceholder": "#2A2C33",
        "TemplateFocusedPlaceholder": "#3A3C45",
        "TemplateReadOnlyPlaceholder": "#232429",
        "WordWrapMarker": "#2A2C33"
    }
}
