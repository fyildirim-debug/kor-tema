{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "cachyos_small",
    "color": { "1": "38;2;238;90;54", "2": "38;2;255;138;107" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;238;90;54", "title": "38;2;255;138;107", "output": "38;2;232;230;227" },
    "key": { "width": 9 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;58;60;69m──────────────────────────────────────" },
    { "type": "os", "key": "os", "format": "{name} {arch}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "de", "key": "de" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu", "temp": true },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "mem" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "custom", "format": "\u001b[38;2;58;60;69m──────────────────────────────────────" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
